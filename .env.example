# Application
APP_NAME="Sönaiyaa"
APP_VERSION="1.0.0"
DEBUG=False            # True en local (auto-vérifie les comptes, expose /docs)
API_PREFIX="/api/v1"
ENVIRONMENT=production # production | staging | local

# Server
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://api.sonaiyaa.fr

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/livraison_db

# Security
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8h
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin seed (scripts/init_db.py) — REQUIS pour créer le compte admin.
# Aucun admin par défaut n'est créé sans ces variables. Mot de passe min 12 car.
ADMIN_PHONE=+224XXXXXXXXX
ADMIN_PASSWORD=

# SMS — PasseInfo (provider local Guinée)
PASSEINFO_API_KEY=
PASSEINFO_CLIENT_ID=

# Firebase (push notifications) — JSON inline OU chemin vers le fichier
FIREBASE_CREDENTIALS=
# FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# Cloudflare R2 (stockage documents)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sonaiyaa-documents
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# GeniusPay (Mobile Money — checkout + payouts)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_WALLET_ID=

# Redis
REDIS_URL=redis://localhost:6379/0

# Monitoring (optionnel — laisser vide pour désactiver Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=False

# Geolocation
DEFAULT_SEARCH_RADIUS_KM=5.0
MAX_SEARCH_RADIUS_KM=10.0
MIN_SEARCH_RADIUS_KM=1.0

# Business rules
MAX_COURSES_SIMULTANEES=2
PLATFORM_COMMISSION_PERCENTAGE=15.0

# CORS
CORS_ORIGINS=["https://sonaiyaa.fr", "https://sonaiyaa.com", "http://localhost:5173"]
